# All values are optional; defaults are shown.
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Comma-separated Binance symbols. Must exist in src/domain/pairs.ts.
PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,DOGEUSDT,XRPUSDT,BNBUSDT,ADAUSDT,LINKUSDT

# binance | simulated (synthetic high-rate feed, no network needed)
MARKET_SOURCE=binance
# Use wss://data-stream.binance.vision if stream.binance.com is blocked in your region.
BINANCE_WS_URL=wss://stream.binance.com:9443
SIMULATED_UPDATES_PER_SECOND=200

# Default emit interval per client, and the range a client may request.
BROADCAST_INTERVAL_MS=100
MIN_CLIENT_INTERVAL_MS=10
MAX_CLIENT_INTERVAL_MS=1000

# Slow-consumer protection.
MAX_CLIENTS=100
CLIENT_HIGH_WATERMARK_BYTES=262144
CLIENT_HARD_LIMIT_BYTES=1048576
CLIENT_MAX_CONGESTION_MS=5000

STATS_LOG_INTERVAL_MS=10000

# Accounts
# Required in production (32+ characters). A fixed development secret is used otherwise.
# AUTH_SECRET=
AUTH_TOKEN_TTL=7d
AUTH_RATE_LIMIT_MAX=20
DATA_DIR=./data
CLIENT_AUTH_DEADLINE_MS=5000
