{
  "name": "@pulsecrypto/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Market data gateway between Binance public streams and PulseCrypto clients",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@pulsecrypto/contracts": "workspace:*",
    "fastify": "^5.12.5",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "eslint": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
